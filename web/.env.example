# Copy this to .env.local for local dev, and set the same names in
# Vercel → Project Settings → Environment Variables for production.
# See web/README.md for full setup steps.

# --- Auth (Google login + email allowlist) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated, no spaces needed (trimmed automatically).
ALLOWED_EMAILS=you@example.com,teammate@example.com

# --- Visit tracking (logs to a Google Sheet via the pipeline's service account) ---
# The full service-account JSON key, as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The spreadsheet ID from its URL (the part between /d/ and /edit).
VISIT_LOG_SPREADSHEET_ID=
